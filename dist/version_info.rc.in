#include "winresrc.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @LICHII_VERSION_NUMBER@,0,0,0
PRODUCTVERSION @LICHII_VERSION_NUMBER@,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Guarana contributors"
            VALUE "FileDescription", "@LICHII_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@LICHII_VERSION_STRING@"
            VALUE "InternalName", "@LICHII_FILE_NAME@"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Based on Lichii, Eden, Eglantine and yuzu."
            VALUE "OriginalFilename", "@LICHII_FILE_NAME@"
            VALUE "ProductName", "Guarana"
            VALUE "ProductVersion", "@LICHII_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
