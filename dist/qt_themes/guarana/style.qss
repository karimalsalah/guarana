/* Guarana additions ----------------------------------------------------- */

/* Text on an amber fill is dark ink, as on the launcher's primary button. */
QPushButton:default,
QPushButton:default:hover,
QPushButton:default:pressed {
    color: #1a1204;
}

/* Focus ring for keyboard and controller navigation: 2 px amber on anything that takes focus. */
QPushButton:focus,
QToolButton:focus,
QCheckBox:focus,
QRadioButton:focus,
QSlider:focus,
QTabBar::tab:focus {
    border: 2px solid #fbbf24;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QComboBox:on,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 2px solid #fbbf24;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: rgba(242, 133, 26, 0.22);
    color: #ffffff;
}

QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 2px solid rgba(251, 191, 36, 0.70);
}

QListView::item:focus,
QTreeView::item:focus {
    outline: 2px solid #fbbf24;
    outline-offset: -2px;
}

QToolTip {
    border-radius: 8px;
}

/* First-run panel and the in-game toast (src/lichii/guarana_ui.cpp). */
QFrame#GuaranaEmptyPanel {
    background-color: #0e1527;
    border: 1px solid #1f2a44;
    border-radius: 8px;
}

QFrame#GuaranaCard {
    background-color: #141d33;
    border: 1px solid #1f2a44;
    border-radius: 8px;
}

QFrame#GuaranaCard[active="true"] {
    border: 2px solid #f2851a;
}

QLabel#GuaranaHeading {
    font-size: 20px;
    font-weight: 600;
    color: #eef1f6;
}

QLabel#GuaranaHelp {
    color: #8f99ad;
}

QLabel#GuaranaToast {
    background-color: rgba(11, 16, 29, 0.92);
    color: #eef1f6;
    border: 1px solid #2a3652;
    border-radius: 8px;
    padding: 8px 14px;
}
