*/

/* Guarana Dark, derived from Lichii Dark by tools/ui/make_guarana_theme.py. Tokens, from the design's component sheet:
   window #0b101d  chrome #080c16  sunken #0a0f1b  header #0f1627
   surface #0e1527  raised #141d33  hover #1b2640  pressed #222f4d
   border #2a3652  border-subtle #1f2a44  divider #182036
   text #eef1f6  secondary #c2c9d6  muted #8f99ad  faint #6b7589  disabled #4d576b
   accent #f2851a  accent-hover #f99a3c  accent-pressed #d9720f  accent-soft rgba(242,133,26,0.16)
   success #5cb87a  warning #d9a441  danger #c95d5d
   radius 5 / 7 / 10, row height 30 */

QWidget {
    color: #eef1f6;
    background-color: #0b101d;
    selection-background-color: rgba(242, 133, 26, 0.35);
    selection-color: #ffffff;
    border: 0;
    outline: 0;
}

QWidget:disabled {
    color: #4d576b;
}

QToolTip {
    color: #eef1f6;
    background-color: #141d33;
    border: 1px solid #2a3652;
    border-radius: 8px;
    padding: 6px 8px;
}

QMainWindow::separator {
    background-color: #1f2a44;
    width: 1px;
    height: 1px;
}

QLabel {
    background-color: transparent;
}

QLabel:disabled {
    color: #4d576b;
}

/* Menus ----------------------------------------------------------------- */

QMenuBar {
    background-color: #080c16;
    border-bottom: 1px solid #1f2a44;
    padding: 3px 6px;
}

QMenuBar::item {
    background: transparent;
    color: #d3d9e4;
    padding: 5px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1b2640;
    color: #ffffff;
}

QMenu {
    background-color: #0e1527;
    border: 1px solid #2a3652;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    color: #dde2ec;
    padding: 6px 28px 6px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #f2851a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #4d576b;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: #1b2640;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    padding-left: 6px;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    image: url(:/guarana/icons/check_on.png);
}

QMenu::right-arrow {
    image: url(:/guarana/icons/chevron_right.png);
    width: 12px;
    height: 12px;
    padding-right: 6px;
}

/* Buttons --------------------------------------------------------------- */

QPushButton {
    background-color: #141d33;
    color: #eef1f6;
    border: 1px solid #2a3652;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #1b2640;
}

QPushButton:pressed,
QPushButton:checked {
    background-color: #222f4d;
}

QPushButton:focus {
    border-color: rgba(251, 191, 36, 0.70);
}

QPushButton:default {
    background-color: #f2851a;
    border-color: #f2851a;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #f99a3c;
    border-color: #f99a3c;
}

QPushButton:default:pressed {
    background-color: #d9720f;
    border-color: #d9720f;
}

QPushButton:disabled,
QPushButton:default:disabled {
    background-color: #0f1627;
    border-color: #1f2a44;
    color: #4d576b;
}

QPushButton::menu-indicator {
    image: url(:/guarana/icons/chevron_down.png);
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 6px;
    width: 12px;
    height: 12px;
}

QToolButton {
    background-color: transparent;
    color: #eef1f6;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 3px;
}

QToolButton:hover {
    background-color: #1b2640;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #222f4d;
}

QDialogButtonBox {
    background-color: transparent;
    dialogbuttonbox-buttons-have-icons: 0;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* Inputs ---------------------------------------------------------------- */

QLineEdit,
QAbstractSpinBox,
QComboBox,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit {
    background-color: #0e1527;
    color: #eef1f6;
    border: 1px solid #2a3652;
    border-radius: 8px;
    selection-background-color: rgba(242, 133, 26, 0.45);
}

QLineEdit,
QAbstractSpinBox,
QComboBox,
QDateTimeEdit {
    min-height: 28px;
    padding: 0 10px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover {
    border-color: #3a4868;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QComboBox:on,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #f2851a;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QDateTimeEdit:disabled {
    background-color: #0f1627;
    border-color: #1f2a44;
    color: #4d576b;
}

QLineEdit:read-only {
    background-color: #0f1627;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: 0;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/guarana/icons/chevron_down.png);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(:/guarana/icons/chevron_down_disabled.png);
}

QComboBox QAbstractItemView {
    background-color: #0e1527;
    border: 1px solid #2a3652;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: #1b2640;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 0 8px;
    border-radius: 8px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #1b2640;
    color: #ffffff;
}

QComboBox[global="true"] {
    color: #8f99ad;
}

QAbstractSpinBox {
    padding-right: 22px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: 0;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-arrow {
    image: url(:/guarana/icons/chevron_up.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/guarana/icons/chevron_down.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/guarana/icons/chevron_up_disabled.png);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(:/guarana/icons/chevron_down_disabled.png);
}

QCalendarWidget QWidget {
    alternate-background-color: #0f1627;
}

/* Check boxes, toggles, radios ------------------------------------------ */

QCheckBox,
QRadioButton {
    background-color: transparent;
    spacing: 10px;
    min-height: 24px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator,
QListView::indicator,
QTableView::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked,
QAbstractItemView::indicator:unchecked {
    image: url(:/guarana/icons/check_off.png);
}

QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:hover {
    image: url(:/guarana/icons/check_off_hover.png);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    image: url(:/guarana/icons/check_on.png);
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    image: url(:/guarana/icons/check_mixed.png);
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled {
    image: url(:/guarana/icons/check_off_disabled.png);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    image: url(:/guarana/icons/check_on_disabled.png);
}

/* A setting that switches a feature on or off. ConfigurationShared::UseToggles marks them. */
QCheckBox[toggle="true"]::indicator {
    width: 34px;
    height: 20px;
}

QCheckBox[toggle="true"]::indicator:unchecked {
    image: url(:/guarana/icons/toggle_off.png);
}

QCheckBox[toggle="true"]::indicator:unchecked:hover {
    image: url(:/guarana/icons/toggle_off_hover.png);
}

QCheckBox[toggle="true"]::indicator:checked {
    image: url(:/guarana/icons/toggle_on.png);
}

QCheckBox[toggle="true"]::indicator:unchecked:disabled {
    image: url(:/guarana/icons/toggle_off_disabled.png);
}

QCheckBox[toggle="true"]::indicator:checked:disabled {
    image: url(:/guarana/icons/toggle_on_disabled.png);
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QRadioButton::indicator:unchecked {
    image: url(:/guarana/icons/radio_off.png);
}

QRadioButton::indicator:unchecked:hover {
    image: url(:/guarana/icons/radio_off_hover.png);
}

QRadioButton::indicator:checked {
    image: url(:/guarana/icons/radio_on.png);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/guarana/icons/radio_off_disabled.png);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/guarana/icons/radio_on_disabled.png);
}

/* Per-game settings: a value changed for this game, and its reset button. */
ConfigurationShared--Widget[custom="true"] QLabel,
ConfigurationShared--Widget[custom="true"] QCheckBox {
    color: #ffffff;
    font-weight: 600;
}

ConfigurationShared--Widget[custom="true"] QComboBox,
ConfigurationShared--Widget[custom="true"] QLineEdit,
ConfigurationShared--Widget[custom="true"] QAbstractSpinBox {
    border-color: rgba(251, 191, 36, 0.70);
}

QPushButton[restore="true"] {
    background-color: #2a1b0c;
    border: 0;
    border-radius: 8px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton[restore="true"]:hover {
    background-color: #33210f;
}

/* Sliders and progress -------------------------------------------------- */

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background-color: #2a3652;
}

QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: 2px;
    background-color: #f2851a;
}

QSlider::sub-page:horizontal:disabled {
    background-color: #5c3a14;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background-color: #ffffff;
}

QSlider::handle:horizontal:disabled {
    background-color: #6b6d73;
}

QSlider::groove:vertical {
    width: 4px;
    border-radius: 2px;
    background-color: #2a3652;
}

QSlider::add-page:vertical {
    width: 4px;
    border-radius: 2px;
    background-color: #f2851a;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
    background-color: #ffffff;
}

QProgressBar {
    background-color: #1b2640;
    border: 0;
    border-radius: 3px;
    color: #c2c9d6;
    text-align: center;
    min-height: 6px;
}

QProgressBar::chunk {
    background-color: #f2851a;
    border-radius: 3px;
}

/* Scroll bars ----------------------------------------------------------- */

QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #33405d;
    min-height: 32px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: #33405d;
    min-width: 32px;
    border-radius: 3px;
}

QScrollBar::handle:hover {
    background-color: #6a6c73;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    width: 0;
    height: 0;
    border: 0;
}

/* Tabs ------------------------------------------------------------------ */

QTabWidget::pane {
    border: 0;
    border-top: 1px solid #1f2a44;
    background-color: #0b101d;
    top: -1px;
}

QTabWidget::tab-bar {
    left: 12px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: #8f99ad;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 10px 10px 9px 10px;
    margin-right: 2px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #eef1f6;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #f2851a;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #4d576b;
}

QTabBar QToolButton {
    background-color: #141d33;
    border: 1px solid #1f2a44;
    border-radius: 8px;
    width: 24px;
    margin: 6px 1px;
}

QTabBar QToolButton:disabled {
    background-color: #0b101d;
}

QTabBar::scroller {
    width: 56px;
}

QTabBar QToolButton::left-arrow {
    image: url(:/guarana/icons/chevron_left.png);
}

QTabBar QToolButton::left-arrow:disabled {
    image: url(:/guarana/icons/chevron_left_disabled.png);
}

QTabBar QToolButton::right-arrow {
    image: url(:/guarana/icons/chevron_right.png);
}

QTabBar QToolButton::right-arrow:disabled {
    image: url(:/guarana/icons/chevron_right_disabled.png);
}

/* Group boxes become section headers ------------------------------------ */

QGroupBox {
    background-color: transparent;
    border: 0;
    border-top: 1px solid #182036;
    margin-top: 26px;
    padding-top: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 4px;
    color: #6b7589;
    background-color: transparent;
}

/* Item views: game list, category list, trees --------------------------- */

QAbstractItemView {
    background-color: #0b101d;
    alternate-background-color: #0f1627;
    border: 0;
    selection-background-color: #33210f;
    selection-color: #ffffff;
    show-decoration-selected: 1;
}

QAbstractItemView::item {
    border: 0;
}

QAbstractItemView::item:hover {
    background-color: #0f1627;
}

QAbstractItemView::item:selected,
QAbstractItemView::item:selected:active,
QAbstractItemView::item:selected:!active {
    background-color: #33210f;
    color: #ffffff;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:selected {
    background-color: #33210f;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/guarana/icons/chevron_right.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/guarana/icons/chevron_down.png);
}

QHeaderView {
    background-color: #0b101d;
    border: 0;
}

QHeaderView::section {
    background-color: #0b101d;
    color: #8f99ad;
    border: 0;
    border-bottom: 1px solid #1f2a44;
    padding: 0 8px;
    min-height: 32px;
}

QHeaderView::section:hover {
    color: #eef1f6;
}

QHeaderView::down-arrow {
    image: url(:/guarana/icons/chevron_down.png);
    width: 10px;
    height: 10px;
}

QHeaderView::up-arrow {
    image: url(:/guarana/icons/chevron_up.png);
    width: 10px;
    height: 10px;
}

QTableView {
    gridline-color: #182036;
}

QTableCornerButton::section {
    background-color: #0b101d;
    border: 0;
}

QScrollArea QListWidget {
    background-color: #0a0f1b;
    border: 1px solid #1f2a44;
    border-radius: 8px;
}

/* Configure: category list on the left */
QListWidget#selectorList {
    background-color: #0a0f1b;
    border: 0;
    border-right: 1px solid #1f2a44;
    padding: 12px 8px;
    outline: 0;
}

QListWidget#selectorList::item {
    color: #d3d9e4;
    min-height: 34px;
    padding: 0 10px;
    border-radius: 8px;
    margin-bottom: 2px;
}

QListWidget#selectorList::item:hover {
    background-color: #1b2640;
}

QListWidget#selectorList::item:selected {
    background-color: rgba(242, 133, 26, 0.16);
    color: #ffffff;
    font-weight: 600;
}

/* Per-game Properties: the game's info column */
QDialog#ConfigurePerGame QGroupBox#gameInfo {
    background-color: #0a0f1b;
    border: 0;
    border-right: 1px solid #1f2a44;
    margin-top: 0;
    padding: 16px 12px;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo::title {
    color: transparent;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo QLineEdit {
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid #182036;
    border-radius: 0;
    padding: 0 2px;
    color: #eef1f6;
}

QDialog#ConfigurePerGame QGraphicsView {
    border-radius: 8px;
    background-color: #0e1527;
}

QDialog#ConfigureDialog QLabel#label,
QDialog#ConfigurePerGame QLabel#label_8 {
    color: #6b7589;
}

/* About ---------------------------------------------------------------- */

QDialog#AboutDialog QLabel#labelAbout {
    color: #c2c9d6;
}

QDialog#AboutDialog QLabel#labelBuildInfo,
QDialog#AboutDialog QLabel#labelLiability {
    color: #8f99ad;
}

/* What's new ------------------------------------------------------------ */

QDialog#WhatsNewDialog QLabel#WhatsNewText {
    color: #8f99ad;
}

QDialog#WhatsNewDialog QLabel#WhatsNewBadge {
    background-color: rgba(242, 133, 26, 0.16);
    border-radius: 8px;
}

QDialog#WhatsNewDialog QWidget#WhatsNewItem {
    border-bottom: 1px solid #182036;
}

QDialog#WhatsNewDialog QWidget#WhatsNewFooter {
    background-color: #0a0f1b;
    border-top: 1px solid #1f2a44;
}

/* Status bar: setting chips on the left, stats on the right ------------- */

QStatusBar {
    background-color: #080c16;
    border-top: 1px solid #1f2a44;
    color: #8f99ad;
}

QStatusBar::item {
    border: 0;
}

QStatusBar QLabel {
    color: #8f99ad;
    padding: 0 4px;
}

QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 4px;
    margin: 0;
    border: 0;
    border-radius: 8px;
    background-color: #0e1527;
    color: #c2c9d6;
    font-size: 11px;
}

QPushButton#TogglableStatusBarButton:!checked {
    background-color: transparent;
    color: #4d576b;
}

QPushButton#RendererStatusBarButton {
    background-color: rgba(242, 133, 26, 0.16);
    color: #f2851a;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover {
    background-color: #1b2640;
    color: #eef1f6;
}

QPushButton#RefreshButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 4px;
    border: 0;
    background-color: transparent;
    color: #6b7589;
}

QPushButton#RefreshButton:hover {
    color: #eef1f6;
}

QPushButton#buttonRefreshDevices {
    min-width: 30px;
    max-width: 30px;
    padding: 0;
}

QPushButton#button_reset_defaults {
    padding: 0 12px;
}

/* Controller applet, input pages and software keyboard (from qdarkstyle) ----- */

QSpinBox#spinboxLStickRange,
QSpinBox#spinboxRStickRange,
QSpinBox#vibrationSpinPlayer1,
QSpinBox#vibrationSpinPlayer2,
QSpinBox#vibrationSpinPlayer3,
QSpinBox#vibrationSpinPlayer4,
QSpinBox#vibrationSpinPlayer5,
QSpinBox#vibrationSpinPlayer6,
QSpinBox#vibrationSpinPlayer7,
QSpinBox#vibrationSpinPlayer8 {
    min-width: 68px;
}

QDialog#ConfigureVibration QGroupBox::indicator,
QGroupBox#motionGroup::indicator,
QGroupBox#vibrationGroup::indicator {
    margin-left: 0px;
}

QDialog#ConfigureVibration QGroupBox::title,
QGroupBox#motionGroup::title,
QGroupBox#vibrationGroup::title {
    spacing: 2px;
    padding-left: 1px;
    padding-right: 1px;
}

QWidget#bottomPerGameInput,
QWidget#topControllerApplet,
QWidget#bottomControllerApplet,
QGroupBox#groupPlayer1Connected:checked,
QGroupBox#groupPlayer2Connected:checked,
QGroupBox#groupPlayer3Connected:checked,
QGroupBox#groupPlayer4Connected:checked,
QGroupBox#groupPlayer5Connected:checked,
QGroupBox#groupPlayer6Connected:checked,
QGroupBox#groupPlayer7Connected:checked,
QGroupBox#groupPlayer8Connected:checked {
    background-color: #232629;
}

QWidget#topPerGameInput,
QWidget#middleControllerApplet {
    background-color: #31363b;
}

QWidget#topPerGameInput QComboBox,
QWidget#middleControllerApplet QComboBox {
    width: 120px;
}

QWidget#connectedControllers {
    background: transparent;
}

QWidget#closeButtons {
    background: transparent;
}

QWidget#playersSupported,
QWidget#controllersSupported,
QWidget#controllerSupported1,
QWidget#controllerSupported2,
QWidget#controllerSupported3,
QWidget#controllerSupported4,
QWidget#controllerSupported5,
QWidget#controllerSupported6 {
    border: none;
    background: transparent;
}

