{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git describe *)",
      "Bash(git cherry *)",
      "Bash(git fetch *)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r *)",
      "Bash(git branch --list *)",
      "Bash(git branch --contains *)",
      "Bash(git tag --list *)",
      "Bash(git worktree list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh search prs *)",
      "Bash(gh search issues *)",
      "Bash(gh search commits *)",
      "Bash(cmake --version)",
      "Bash(cmake --build *)",
      "Bash(ctest *)",
      "Bash(bash scripts/build-linux.sh *)",
      "Bash(bash scripts/run-tests.sh *)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/run-tests.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1 *)",
      "Bash(python tools/nx2/test_debug_mcp.py)",
      "Bash(python3 tools/nx2/test_debug_mcp.py)",
      "Bash(python tools/nx2/test_cache_metrics.py)",
      "Bash(python3 tools/nx2/test_cache_metrics.py)",
      "Bash(python tools/nx2/test_cache_bench.py)",
      "Bash(python3 tools/nx2/test_cache_bench.py)",
      "Bash(python -I tools/bench/test_bench.py)",
      "Bash(python3 -I tools/bench/test_bench.py)",
      "Bash(python -I tools/bench/bench.py validate *)",
      "Bash(python3 -I tools/bench/bench.py validate *)",
      "Bash(python -I tools/bench/bench.py compare *)",
      "Bash(python3 -I tools/bench/bench.py compare *)",
      "Bash(python -I tools/bench/bench.py table *)",
      "Bash(python3 -I tools/bench/bench.py table *)",
      "Bash(bash tools/ci/changelog-section.sh *)",
      "Bash(sha256sum *)",
      "mcp__emulator-debug__status",
      "mcp__emulator-debug__frame_times",
      "mcp__emulator-debug__screenshot",
      "mcp__emulator-debug__log_tail",
      "mcp__emulator-debug__memory",
      "mcp__emulator-debug__power",
      "mcp__emulator-debug__capture_image"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag -a *)",
      "Bash(git tag -f *)",
      "Bash(git tag -d *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh release delete *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh api *)",
      "Bash(python -I tools/bench/bench.py run *)",
      "Bash(python3 -I tools/bench/bench.py run *)",
      "Bash(python -I tools/bench/bench.py suite *)",
      "Bash(python3 -I tools/bench/bench.py suite *)",
      "Bash(python -I tools/bench/play.py *)",
      "Bash(python3 -I tools/bench/play.py *)"
    ],
    "deny": [
      "Read(**/prod.keys)",
      "Read(**/title.keys)",
      "Read(~/**/prod.keys)",
      "Read(~/**/title.keys)"
    ]
  }
}
