#version 460 core

// Predicts the frame `advance` of a frame interval after the presented one. A pixel at p moves to
// p - advance * motion(p), so each output pixel q solves p = q + advance * motion(p).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D frame_color;
layout(binding = 1) uniform sampler2D guide; // xy: motion to the previous frame (UV), z: nearness
layout(binding = 2) uniform sampler2D hud_reference; // the scene before the HUD
layout(binding = 3) uniform sampler2D hud_composite; // the same frame with the HUD
layout(binding = 4, rgba8) uniform writeonly image2D out_frame;

layout(push_constant) uniform Parameters {
    vec2 screen_origin; // the scene's rectangle in the frame (pixels)
    vec2 screen_size;
    float advance;
    uint flags;
} params;

const uint FLAG_HUD = 1u;
const uint FLAG_DEBUG = 2u;
const uint FLAG_HUD_LINEAR = 4u; // hud_reference is linear, hud_composite sRGB-encoded

const float CONVERGED_PIXELS = 2.0;
const float MAX_TRAVEL = 0.25; // of the screen; anything longer is not a prediction
const float NEARER_RATIO = 1.25;
const float NEARER_BIAS = 1e-5;

struct Solution {
    vec2 position;  // source UV in the presented frame's scene
    vec2 previous;  // the estimate before it
    float nearness; // of the pixel the last step was taken from
    float error;    // pixels the last step still moved
};

Solution Solve(vec2 target, vec3 start) {
    vec2 before = target;
    vec3 sampled = start;
    vec2 after = target + params.advance * sampled.xy;
    for (int i = 0; i < 2; ++i) {
        before = after;
        sampled = textureLod(guide, before, 0.0).xyz;
        after = target + params.advance * sampled.xy;
    }
    return Solution(after, before, sampled.z, length((after - before) * params.screen_size));
}

bool IsHud(vec2 uv) {
    vec3 reference = textureLod(hud_reference, uv, 0.0).rgb;
    if ((params.flags & FLAG_HUD_LINEAR) != 0u) {
        reference = clamp(reference, 0.0, 1.0);
        reference = mix(1.055 * pow(reference, vec3(1.0 / 2.4)) - 0.055, 12.92 * reference,
                        lessThan(reference, vec3(0.0031308)));
    }
    vec3 overlay = textureLod(hud_composite, uv, 0.0).rgb - reference;
    float difference = max(max(abs(overlay.r), abs(overlay.g)), abs(overlay.b));
    return difference > 0.07;
}

void Store(ivec2 pixel, vec3 color, vec3 tint) {
    if ((params.flags & FLAG_DEBUG) != 0u) {
        color = mix(color, tint, 0.6);
    }
    imageStore(out_frame, pixel, vec4(color, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(out_frame);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    vec2 target = (vec2(pixel) + 0.5 - params.screen_origin) / params.screen_size;
    if (any(lessThan(target, vec2(0.0))) || any(greaterThan(target, vec2(1.0)))) {
        imageStore(out_frame, pixel, vec4(texelFetch(frame_color, pixel, 0).rgb, 1.0));
        return;
    }
    bool hud = (params.flags & FLAG_HUD) != 0u;
    if (hud && IsHud(target)) {
        Store(pixel, texelFetch(frame_color, pixel, 0).rgb, vec3(0.0, 1.0, 0.0));
        return;
    }

    vec3 here = textureLod(guide, target, 0.0).xyz;
    Solution solution = Solve(target, here);

    // A nearer neighbour moving over this pixel wins.
    vec2 reach = 2.0 / vec2(textureSize(guide, 0));
    vec3 front = here;
    for (int i = 0; i < 4; ++i) {
        vec2 offset = vec2((i & 1) * 2 - 1, (i >> 1) * 2 - 1) * reach;
        vec3 neighbour = textureLod(guide, target + offset, 0.0).xyz;
        if (neighbour.z > front.z) {
            front = neighbour;
        }
    }
    if (front.z > here.z * NEARER_RATIO + NEARER_BIAS) {
        Solution covering = Solve(target, front);
        bool nearer = covering.nearness > solution.nearness * NEARER_RATIO + NEARER_BIAS;
        if (covering.error < CONVERGED_PIXELS &&
            (nearer || solution.error >= CONVERGED_PIXELS)) {
            solution = covering;
        }
    }

    vec3 tint = vec3(0.0);
    bool fallback = false;
    vec2 source = solution.position;
    if (solution.error >= CONVERGED_PIXELS) {
        // Disoccluded: the solve alternates between what moved away and what was behind it.
        float behind = textureLod(guide, solution.position, 0.0).z;
        source = behind < solution.nearness ? solution.position : solution.previous;
        tint = vec3(1.0, 0.0, 0.0);
        fallback = true;
    }
    vec2 travel = source - target;
    if (dot(travel, travel) > MAX_TRAVEL * MAX_TRAVEL) {
        source = target;
        tint = vec3(1.0, 0.0, 1.0);
        fallback = true;
    }
    vec2 half_texel = 0.5 / params.screen_size;
    vec2 clamped = clamp(source, half_texel, vec2(1.0) - half_texel);
    if (clamped != source) {
        source = clamped;
        tint = vec3(0.0, 0.0, 1.0);
        fallback = true;
    }
    // Scene pixels must not drag the HUD along.
    if (hud && IsHud(source)) {
        source = target;
        tint = vec3(1.0, 1.0, 0.0);
        fallback = true;
    }

    vec2 frame_uv = (params.screen_origin + source * params.screen_size) /
                    vec2(textureSize(frame_color, 0));
    vec3 color = textureLod(frame_color, frame_uv, 0.0).rgb;
    if (fallback) {
        Store(pixel, color, tint);
    } else {
        imageStore(out_frame, pixel, vec4(color, 1.0));
    }
}
