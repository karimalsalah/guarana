#version 460 core

// Predicts the frame `advance` of a frame interval after the presented one. A pixel at p moves to
// p - advance * motion(p), so each output pixel q solves p = q + advance * motion(p).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D frame_color;
layout(binding = 1) uniform sampler2D guide; // xy: motion to the previous frame (UV), z: nearness
layout(binding = 2) uniform sampler2D hud_reference; // the scene before the HUD
layout(binding = 3) uniform sampler2D hud_composite; // the same frame with the HUD
// No format: the view has the frame's own (B8G8R8A8 on most swapchains), and a declared rgba8
// would swap red and blue on drivers that honour the declaration (shaderStorageImageWriteWithoutFormat).
layout(binding = 4) uniform writeonly image2D out_frame;

layout(push_constant) uniform Parameters {
    vec2 screen_origin; // the scene's rectangle in the frame (pixels)
    vec2 screen_size;
    float advance;
    uint flags;
} params;

const uint FLAG_HUD = 1u;
const uint FLAG_DEBUG = 2u;
const uint FLAG_HUD_LINEAR = 4u; // hud_reference is linear, hud_composite sRGB-encoded
const uint FLAG_HUD_EXACT = 8u;  // both are linear and equal wherever there is no HUD
const uint FLAG_DEBUG_MOVED = 16u; // also tint every pixel moved by the prediction (debug 2)
const uint FLAG_HUD_DILATE = 32u;  // a pixel next to the HUD counts as HUD (anti-aliased edges)
const uint FLAG_HUD_FILL = 64u;    // a source under the HUD takes the scene there, not this pixel

const float CONVERGED_PIXELS = 2.0;
const float MAX_TRAVEL = 0.25; // of the screen; anything longer is not a prediction
const float NEARER_RATIO = 1.25;
const float NEARER_BIAS = 1e-5;

struct Solution {
    vec2 position;  // source UV in the presented frame's scene
    vec2 previous;  // the estimate before it
    float nearness; // of the pixel the last step was taken from
    float error;    // pixels the last step still moved
};

Solution Solve(vec2 target, vec3 start) {
    vec2 before = target;
    vec3 sampled = start;
    vec2 after = target + params.advance * sampled.xy;
    for (int i = 0; i < 2; ++i) {
        before = after;
        sampled = textureLod(guide, before, 0.0).xyz;
        after = target + params.advance * sampled.xy;
    }
    return Solution(after, before, sampled.z, length((after - before) * params.screen_size));
}

vec3 Encode(vec3 linear) {
    linear = clamp(linear, 0.0, 1.0);
    return mix(1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055, 12.92 * linear,
               lessThan(linear, vec3(0.0031308)));
}

bool IsHudAt(vec2 uv) {
    vec3 reference = textureLod(hud_reference, uv, 0.0).rgb;
    vec3 composite = textureLod(hud_composite, uv, 0.0).rgb;
    float limit = 0.07;
    if ((params.flags & FLAG_HUD_EXACT) != 0u) {
        reference = Encode(reference);
        composite = Encode(composite);
        limit = 0.02;
    } else if ((params.flags & FLAG_HUD_LINEAR) != 0u) {
        reference = Encode(reference);
    }
    vec3 overlay = abs(composite - reference);
    return max(max(overlay.r, overlay.g), overlay.b) > limit;
}

// The scene without the HUD at uv, as the presented frame holds it: the frame plus the difference
// between the scene and the composite there, both in the encoding IsHudAt compares them in, so the
// presented frame's own scaling and encoding carry over.
vec3 SceneUnderHud(vec2 uv, vec2 frame_uv) {
    vec3 reference = textureLod(hud_reference, uv, 0.0).rgb;
    vec3 composite = textureLod(hud_composite, uv, 0.0).rgb;
    if ((params.flags & FLAG_HUD_EXACT) != 0u) {
        reference = Encode(reference);
        composite = Encode(composite);
    } else if ((params.flags & FLAG_HUD_LINEAR) != 0u) {
        reference = Encode(reference);
    }
    vec3 presented = textureLod(frame_color, frame_uv, 0.0).rgb;
    return clamp(presented + reference - composite, 0.0, 1.0);
}

bool IsHud(vec2 uv) {
    if (IsHudAt(uv)) {
        return true;
    }
    if ((params.flags & FLAG_HUD_DILATE) == 0u) {
        return false;
    }
    // Text and icons are anti-aliased: their faint edge pixels differ from the scene by less
    // than the limit and would be moved with it.
    vec2 texel = 1.0 / vec2(textureSize(hud_reference, 0));
    return IsHudAt(uv + vec2(texel.x, 0.0)) || IsHudAt(uv - vec2(texel.x, 0.0)) ||
           IsHudAt(uv + vec2(0.0, texel.y)) || IsHudAt(uv - vec2(0.0, texel.y));
}

void Store(ivec2 pixel, vec3 color, vec3 tint) {
    if ((params.flags & FLAG_DEBUG) != 0u) {
        color = mix(color, tint, 0.6);
    }
    imageStore(out_frame, pixel, vec4(color, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(out_frame);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    if ((params.flags & FLAG_DEBUG_MOVED) != 0u && pixel.y < 6) {
        // A bar along the top: its length is the prediction's advance, in frame intervals (the
        // frame's width is 3), so a screenshot says how far ahead the frame was predicted.
        float bar = float(pixel.x) / float(extent.x) * 3.0;
        imageStore(out_frame, pixel, vec4(bar < params.advance ? vec3(1.0) : vec3(0.1), 1.0));
        return;
    }

    vec2 target = (vec2(pixel) + 0.5 - params.screen_origin) / params.screen_size;
    if (any(lessThan(target, vec2(0.0))) || any(greaterThan(target, vec2(1.0)))) {
        imageStore(out_frame, pixel, vec4(texelFetch(frame_color, pixel, 0).rgb, 1.0));
        return;
    }
    bool hud = (params.flags & FLAG_HUD) != 0u;
    if (hud && IsHud(target)) {
        Store(pixel, texelFetch(frame_color, pixel, 0).rgb, vec3(0.0, 1.0, 0.0));
        return;
    }

    vec3 here = textureLod(guide, target, 0.0).xyz;
    Solution solution = Solve(target, here);

    // A nearer neighbour moving over this pixel wins.
    vec2 reach = 2.0 / vec2(textureSize(guide, 0));
    vec3 front = here;
    for (int i = 0; i < 4; ++i) {
        vec2 offset = vec2((i & 1) * 2 - 1, (i >> 1) * 2 - 1) * reach;
        vec3 neighbour = textureLod(guide, target + offset, 0.0).xyz;
        if (neighbour.z > front.z) {
            front = neighbour;
        }
    }
    if (front.z > here.z * NEARER_RATIO + NEARER_BIAS) {
        Solution covering = Solve(target, front);
        bool nearer = covering.nearness > solution.nearness * NEARER_RATIO + NEARER_BIAS;
        if (covering.error < CONVERGED_PIXELS &&
            (nearer || solution.error >= CONVERGED_PIXELS)) {
            solution = covering;
        }
    }

    vec3 tint = vec3(0.0);
    bool fallback = false;
    vec2 source = solution.position;
    if (solution.error >= CONVERGED_PIXELS) {
        // Disoccluded: the solve alternates between what moved away and what was behind it.
        float behind = textureLod(guide, solution.position, 0.0).z;
        source = behind < solution.nearness ? solution.position : solution.previous;
        tint = vec3(1.0, 0.0, 0.0);
        fallback = true;
    }
    vec2 travel = source - target;
    if (dot(travel, travel) > MAX_TRAVEL * MAX_TRAVEL) {
        source = target;
        tint = vec3(1.0, 0.0, 1.0);
        fallback = true;
    }
    vec2 half_texel = 0.5 / params.screen_size;
    vec2 clamped = clamp(source, half_texel, vec2(1.0) - half_texel);
    if (clamped != source) {
        source = clamped;
        tint = vec3(0.0, 0.0, 1.0);
        fallback = true;
    }
    // Scene pixels must not drag the HUD along.
    bool under_hud = false;
    if (hud && IsHud(source)) {
        if ((params.flags & FLAG_HUD_FILL) != 0u) {
            under_hud = true;
        } else {
            source = target;
        }
        tint = vec3(1.0, 1.0, 0.0);
        fallback = true;
    }

    vec2 frame_uv = (params.screen_origin + source * params.screen_size) /
                    vec2(textureSize(frame_color, 0));
    vec3 color = under_hud ? SceneUnderHud(source, frame_uv)
                           : textureLod(frame_color, frame_uv, 0.0).rgb;
    if (fallback) {
        Store(pixel, color, tint);
    } else if ((params.flags & FLAG_DEBUG_MOVED) != 0u &&
               length((source - target) * params.screen_size) > 0.5) {
        // Predicted: taken from somewhere else in the presented frame.
        imageStore(out_frame, pixel, vec4(mix(color, vec3(0.0, 0.8, 0.8), 0.25), 1.0));
    } else {
        imageStore(out_frame, pixel, vec4(color, 1.0));
    }
}
