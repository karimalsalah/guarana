#include "winresrc.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
LICHII_ICON               ICON                    "../../dist/lichii.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/lichii.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
// The numeric version is a placeholder: releases are tagged build-N, which has no
// four-part form. Shown in Explorer's Properties > Details.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Guarana contributors"
            VALUE "FileDescription", "Guarana (command line)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "guarana-cli"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Based on Lichii, Eden, Eglantine and yuzu."
            VALUE "OriginalFilename", "guarana-cli.exe"
            VALUE "ProductName", "Guarana"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
