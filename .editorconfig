# https://editorconfig.org
root = true

# The tree's files are UTF-8 and LF in git; hooks/pre-commit rejects trailing spaces and tab indents
# in src/ and CMakeLists.txt; src/.clang-format indents C++ by 4.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab

# Vendored code keeps its own style.
[externals/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
