# Turns the People table of CONTRIBUTORS.md (generated by tools/ci/legacy.py) into a C++ header
# with the names only, so every build ships the current list in its About dialog.
#
#   guarana_contributors_header(<CONTRIBUTORS.md> <template.h.in> <output.h>)
#
# The template uses @GUARANA_CONTRIBUTOR_LITERALS@: one raw string literal per line. Names are
# written as raw literals after `"`, `\`, `(`, `)` and control characters are removed, so nothing
# a name contains can end the literal or reach the compiler as code. Nothing is HTML here: the
# Qt side escapes each name before it goes into a label. A missing file gives an empty list.
function(guarana_contributors_header SOURCE TEMPLATE OUTPUT)
    set(literals "")
    set(count 0)
    if(EXISTS "${SOURCE}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SOURCE}")
        file(READ "${SOURCE}" text)
        string(FIND "${text}" "## People" start)
        if(NOT start EQUAL -1)
            string(SUBSTRING "${text}" ${start} -1 text)
            string(FIND "${text}" "\n## Tools" stop)
            if(NOT stop EQUAL -1)
                string(SUBSTRING "${text}" 0 ${stop} text)
            endif()
            set(rest "${text}")
            while(count LESS 2000)
                string(REGEX MATCH "\n\|[ ]*([^|\n]+)\|[^\n]*" row "${rest}")
                if("${row}" STREQUAL "")
                    break()
                endif()
                set(cell "${CMAKE_MATCH_1}")
                string(FIND "${rest}" "${row}" at)
                string(LENGTH "${row}" row_length)
                math(EXPR next "${at} + ${row_length}")
                string(SUBSTRING "${rest}" ${next} -1 rest)
                string(STRIP "${cell}" name)
                if(name MATCHES "^\[([^]]+)\]\(")
                    set(name "${CMAKE_MATCH_1}")
                endif()
                if(name STREQUAL "Contributor" OR name MATCHES "^:?-+:?$" OR name MATCHES "^Nobody yet")
                    continue()
                endif()
                string(REGEX REPLACE "[\"\\()\r\t]" "" name "${name}")
                string(STRIP "${name}" name)
                string(LENGTH "${name}" name_length)
                if(name_length GREATER 200)
                    string(SUBSTRING "${name}" 0 200 name)
                endif()
                if(name STREQUAL "")
                    continue()
                endif()
                string(APPEND literals "    R\"GUARANA(${name})GUARANA\",\n")
                math(EXPR count "${count} + 1")
            endwhile()
        endif()
    endif()
    set(GUARANA_CONTRIBUTOR_LITERALS "${literals}")
    configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
endfunction()
